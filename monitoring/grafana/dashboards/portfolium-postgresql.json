    {"type":"timeseries","title":"Application query duration","datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s"}},"targets":[{"expr":"histogram_quantile(0.50, sum by (le) (rate(portfolium_db_query_duration_seconds_bucket[5m])))","legendFormat":"p50","refId":"A"},{"expr":"histogram_quantile(0.95, sum by (le) (rate(portfolium_db_query_duration_seconds_bucket[5m])))","legendFormat":"p95","refId":"B"},{"expr":"histogram_quantile(0.99, sum by (le) (rate(portfolium_db_query_duration_seconds_bucket[5m])))","legendFormat":"p99","refId":"C"}],"gridPos":{"h":8,"w":12,"x":0,"y":13}},
    {"type":"timeseries","title":"Slow queries (>1s)","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum by (operation) (increase(portfolium_db_slow_queries_total[15m]))","legendFormat":"{{operation}}","refId":"A"}],"gridPos":{"h":8,"w":12,"x":12,"y":13}},
