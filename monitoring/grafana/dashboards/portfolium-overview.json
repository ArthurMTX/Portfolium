{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Requests / second",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(portfolium_http_requests_total[5m]))", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "5xx error rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "targets": [{
        "expr": "sum(rate(portfolium_http_errors_total{status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(portfolium_http_requests_total[5m])), 0.001)",
        "refId": "A"
      }],
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "stat",
      "title": "HTTP p95 latency",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (rate(portfolium_http_request_duration_seconds_bucket[5m])))",
        "refId": "A"
      }],
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}
    },
    {
      "type": "stat",
      "title": "Yahoo failures (15m)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(portfolium_yfinance_failures_total[15m]))", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}
    },
    {
      "type": "stat",
      "title": "PostgreSQL",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(pg_up{job=\"portfolium-postgres\"})", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 6}
    },
    {
      "type": "stat",
      "title": "Redis",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(redis_up{job=\"portfolium-redis\"})", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 6}
    },
    {
      "type": "stat",
      "title": "Celery workers",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(celery_worker_up)", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 6}
    },
    {
      "type": "stat",
      "title": "Daily Gain unavailable (1h)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(portfolium_daily_gain_unavailable_total[1h]))", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 6}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["portfolium", "observability"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Portfolium Overview",
  "uid": "portfolium-overview",
  "version": 2
}
