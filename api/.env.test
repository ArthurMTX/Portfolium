# Test environment variables
# This file is used for running tests locally

# Testing flag
TESTING=true
ENVIRONMENT=test

# Database (uses in-memory SQLite for tests)
DATABASE_URL=sqlite:///:memory:

# Security (use simple values for testing)
SECRET_KEY=test-secret-key-not-for-production-12345678901234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin user (disabled for tests by default)
ADMIN_AUTO_CREATE=false
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=testpassword123

# CORS (allow all for tests)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Logging
LOG_LEVEL=INFO
LOG_FILE_ENABLED=false
LOG_FORMAT=readable

# External services are disabled for unit/API tests by default.
# Tests that require Redis must opt in explicitly and carry the integration marker.
REDIS_ENABLED=false
ENABLE_BACKGROUND_TASKS=false

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=Portfolium Test
ASSET_THEME_SUBTHEME_GAP_SUGGESTIONS_ENABLED=false

# Email (mock for tests)
# With email enabled, /auth/login requires user.is_verified,
# which broke every auth_headers-based test when the root .env leaked into the
# shell environment.
ENABLE_EMAIL=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASSWORD=test
SMTP_FROM=noreply@test.local

# Scheduler (disabled for tests)
SCHEDULER_ENABLED=false

# Skip migrations during tests
SKIP_MIGRATIONS=true

# Cache settings
CACHE_TTL_SECONDS=300
